{
  "name": "wise-kit-studio",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "node apps/api/scripts/free-port.mjs 3000 && node apps/api/scripts/free-port.mjs 5181 && pnpm --parallel --filter @wise-kit/api --filter @wise-kit/web run dev",
    "dev:web": "pnpm --filter @wise-kit/web dev",
    "dev:api": "pnpm --filter @wise-kit/api dev",
    "build": "pnpm --filter @wise-kit/shared --filter @wise-kit/web --filter @wise-kit/api run build",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:colors": "node scripts/check-raw-colors.mjs apps/web/src"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  }
}
