{
  "name": "morya-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm -C apps/api dev\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "pnpm -C apps/api dev",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "check:colors": "node scripts/check-raw-colors.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@morya-studio/shared": "workspace:*",
    "echarts": "^6.1.0",
    "html2canvas": "^1.4.1",
    "morya-ui": "^0.5.5",
    "pinia": "^4.0.3",
    "three": "^0.186.1",
    "vue": "^3.5.42",
    "vue-i18n": "^10.0.8",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/echarts": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.6",
    "fast-glob": "^3.3.3",
    "jsdom": "^30.1.2",
    "sass": "^1.105.1",
    "typescript": "~6.0.2",
    "unocss": "^66.11.0",
    "vite": "^8.3.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.11"
  }
}
